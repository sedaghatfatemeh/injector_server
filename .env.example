DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-running
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Enable only when the trusted ingress overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=false
POSTGRES_DB=injector_server
POSTGRES_USER=injector_server
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DEVICE_ONLINE_WINDOW_MINUTES=15
DEVICE_CHECK_IN_MAX_BYTES=4096
DEVICE_EVENT_BATCH_MAX=200
DEVICE_EVENT_BATCH_MAX_BYTES=2097152
DEVICE_EVENT_METADATA_MAX_BYTES=16384
DEVICE_EVENT_METADATA_MAX_DEPTH=8
DEVICE_EVENT_FUTURE_SKEW_SECONDS=300
DEVICE_CHECK_IN_RATE=60/minute
DEVICE_EVENTS_RATE=120/minute
DEVICE_MANIFEST_RATE=30/minute
DEVICE_UPDATE_RESULT_RATE=60/minute
STAFF_LOGIN_RATE=10/minute
API_NUM_PROXIES=0
SOFTWARE_RELEASE_MAX_BYTES=536870912
